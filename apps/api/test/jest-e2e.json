{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "rootDir": "..",
          "module": "esnext",
          "moduleResolution": "bundler"
        }
      }
    ]
  },
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": [
    "<rootDir>/test-env.ts"
  ],
  "maxWorkers": 1,
  "extensionsToTreatAsEsm": [
    ".ts"
  ]
}
