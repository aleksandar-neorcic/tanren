generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A movement you can do in the gym (e.g. "Barbell Bench Press").
model Exercise {
  id          String   @id @default(cuid())
  name        String   @unique
  muscleGroup String?
  notes       String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templateExercises TemplateExercise[]
  sessionExercises  SessionExercise[]
}

/// A reusable workout plan (e.g. "Push day").
model Template {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises TemplateExercise[]
  sessions  WorkoutSession[]
}

/// One exercise slot inside a template, with the planned sets/reps/weight.
model TemplateExercise {
  id           String   @id @default(cuid())
  templateId   String
  exerciseId   String
  order        Int
  targetSets   Int      @default(3)
  targetReps   Int?
  targetWeight Float?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
}

/// One trip to the gym. Usually started from a template but may be freeform.
model WorkoutSession {
  id         String    @id @default(cuid())
  templateId String?
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  notes      String?

  template  Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  exercises SessionExercise[]
}

/// An exercise performed within a session, in order, with its logged sets.
model SessionExercise {
  id         String  @id @default(cuid())
  sessionId  String
  exerciseId String
  order      Int
  done       Boolean @default(false)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets     SetLog[]

  @@unique([sessionId, order])
}

/// A single logged set: weight x reps.
model SetLog {
  id                String   @id @default(cuid())
  sessionExerciseId String
  setNumber         Int
  weight            Float?
  reps              Int?
  done              Boolean  @default(false)
  createdAt         DateTime @default(now())

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
}
